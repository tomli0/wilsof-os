#!/usr/bin/env python3
"""Read-only, offline hardware state; JSON on stdout, no automatic file/upload.

Run as the desktop user. No passwords, SSIDs, addresses, connections, application
streams, personal files or raw journals are emitted. Inaccessible probes remain
explicitly unavailable; this is evidence collection, not hardware acceptance.
"""
import argparse
from datetime import datetime, timezone
import json
import math
import os
from pathlib import Path
import re
import subprocess


PACKAGES = ('linux', 'linux-firmware', 'sof-firmware', 'alsa-ucm-conf',
            'alsa-utils', 'networkmanager', 'wpa_supplicant', 'iw', 'wireless-regdb', 'pipewire',
            'pipewire-audio', 'pipewire-pulse', 'wireplumber', 'bluez',
            'hyprland', 'hyprtoolkit', 'hyprland-guiutils', 'dux-shell', 'quickshell')


def probe(argv, *, run=subprocess.run):
    try:
        r = run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                timeout=8, check=False, env=os.environ | {'LC_ALL': 'C', 'PAGER': 'cat'})
        if argv[0] == 'journalctl' and (not r.stdout.strip() or r.stdout.strip() == '-- No entries --'
                or re.search(r'not seeing|permission|no journal files|access denied', r.stderr, re.I)):
            return {'status': 'unavailable', 'data': ''}
        return {'status': 'ok' if r.returncode == 0 else 'unavailable',
                'exit_code': r.returncode, 'data': r.stdout if r.returncode == 0 else ''}
    except (OSError, subprocess.TimeoutExpired):
        return {'status': 'unavailable', 'data': ''}


def kernel_summary(text):
    missing = []
    for file, code in re.findall(r'Direct firmware load for ([a-zA-Z0-9_/.-]{1,160}) failed with error (-?\d+)', text):
        if not file.startswith('/') and '..' not in Path(file).parts:
            item = {'file': file, 'error': int(code)}
            if item not in missing:
                missing.append(item)
    lines = text.lower().splitlines()
    def count(pattern):
        return sum(bool(re.search(pattern, line)) and bool(re.search(r'fail|error|timeout|timed out', line)) for line in lines)
    return {'missing_firmware': missing,
            'wifi_error_lines': count(r'iwl|ath\d|rtw|rtl|brcm|mt7|cfg80211|wlan'),
            'audio_error_lines': count(r'snd|sof[-_ ]|soundwire|alsa'),
            'bluetooth_error_lines': count(r'bluetooth|btusb|hci\d')}


def audio_summary(devices, default):
    out = []
    for d in devices:
        if not isinstance(d, dict) or not isinstance(d.get('index'), int):
            continue
        volumes = []
        for channel in d.get('volume', {}).values():
            value = channel.get('value_percent', '')
            if isinstance(value, str) and re.fullmatch(r'\d{1,3}%', value):
                volumes.append(int(value[:-1]))
        out.append({'index': d['index'], 'default': d.get('name') == default,
                    'state': d.get('state') if d.get('state') in ('RUNNING', 'IDLE', 'SUSPENDED') else 'UNKNOWN',
                    'mute': d.get('mute') if isinstance(d.get('mute'), bool) else None,
                    'volume_percent': volumes})
    return out


def hardware_ids(sys_root=Path("/sys")):
    pci, usb, radios = [], [], []
    def read(path):
        try:
            return path.read_text().strip()
        except OSError:
            return ''
    for p in sorted((sys_root / 'bus/pci/devices').glob('*')):
        cls = read(p / 'class')
        if not re.fullmatch(r'0x(?:02|03|04)[0-9a-fA-F]{4}', cls):
            continue
        row = {'class': cls}
        for field in ('vendor', 'device', 'subsystem_vendor', 'subsystem_device'):
            value = read(p / field)
            if re.fullmatch(r'0x[0-9a-fA-F]{4}', value):
                row[field] = value
        driver = (p / 'driver').resolve().name if (p / 'driver').is_symlink() else ''
        row['driver'] = driver if re.fullmatch(r'[a-zA-Z0-9_-]{1,64}', driver) else None
        pci.append(row)
    # Numeric USB IDs only; never serials, product/manufacturer strings or names.
    for p in sorted((sys_root / 'bus/usb/devices').glob('*')):
        vendor, product = read(p / 'idVendor'), read(p / 'idProduct')
        if re.fullmatch(r'[0-9a-fA-F]{4}', vendor) and re.fullmatch(r'[0-9a-fA-F]{4}', product):
            usb.append({'vendor': vendor, 'product': product})
    for p in sorted((sys_root / 'class/rfkill').glob('rfkill*')):
        kind = read(p / 'type')
        def blocked(field):
            value = read(p / field)
            return value == '1' if value in ('0', '1') else None
        radios.append({'type': kind if kind in ('wlan', 'bluetooth', 'wwan') else 'other',
                       'soft': blocked('soft'), 'hard': blocked('hard')})
    return {'pci': pci, 'usb': usb, 'rfkill': radios}


def display_summary(monitors):
    out = []
    for m in monitors:
        if not isinstance(m, dict):
            continue
        if not all(type(m.get(k)) is int and 0 < m[k] <= 32768 for k in ('width', 'height')):
            continue
        if not all(type(m.get(k)) in (int, float) and math.isfinite(m[k])
                   and 0 < m[k] <= limit for k, limit in (('scale', 8), ('refreshRate', 1000))):
            continue
        out.append({'width': m['width'], 'height': m['height'], 'scale': m['scale'],
                    'refresh_hz': m['refreshRate'], 'disabled': m.get('disabled') if type(m.get('disabled')) is bool else None})
    return out


def device_state(sys_root=Path('/sys')):
    def read(path):
        try:
            return path.read_text().strip()[:4096]
        except (OSError, UnicodeError):
            return ''
    def module(path):
        link = path / 'device/driver/module'
        name = link.resolve().name if link.is_symlink() else ''
        return name if re.fullmatch(r'[a-zA-Z0-9_-]{1,64}', name) else None
    wireless, bluetooth, supplies = [], [], []
    for p in sorted((sys_root / 'class/net').glob('*')):
        if not ((p / 'wireless').is_dir() or (p / 'phy80211').exists()):
            continue
        if not re.fullmatch(r'[a-zA-Z0-9_.-]{1,32}', p.name):
            continue
        mod = module(p)
        state = read(p / 'operstate')
        wireless.append({'interface':p.name,
                         'state':state if state in ('unknown','notpresent','down','lowerlayerdown','testing','dormant','up') else None,
                         'module':mod, 'module_loaded':(sys_root / 'module' / mod).is_dir() if mod else None})
    for p in sorted((sys_root / 'class/bluetooth').glob('hci*')):
        if re.fullmatch(r'hci[0-9]+', p.name):
            mod = module(p)
            bluetooth.append({'controller':p.name, 'module':mod,
                              'module_loaded':(sys_root / 'module' / mod).is_dir() if mod else None})
    for p in sorted((sys_root / 'class/power_supply').glob('*')):
        kind, status, capacity = read(p / 'type'), read(p / 'status'), read(p / 'capacity')
        supplies.append({'type':kind if kind in ('Battery','Mains','USB','USB_C','USB_PD') else 'other',
                         'status':status if status in ('Unknown','Charging','Discharging','Not charging','Full') else None,
                         'capacity_percent':int(capacity) if capacity.isascii() and capacity.isdigit() and 0 <= int(capacity) <= 100 else None})
    sleep = read(sys_root / 'power/mem_sleep').split()
    allowed = ('s2idle','shallow','deep')
    selected = [s[1:-1] for s in sleep if s.startswith('[') and s.endswith(']') and s[1:-1] in allowed]
    return {'wireless':wireless, 'bluetooth':bluetooth,
            'sleep_states':[s for s in read(sys_root / 'power/state').split() if s in ('freeze','standby','mem','disk')],
            'mem_sleep':{'available':[s.strip('[]') for s in sleep if s.strip('[]') in allowed],
                         'selected':selected[0] if len(selected) == 1 else None},
            'power_supplies':supplies}


def firmware_summary(text, firmware_root=Path('/usr/lib/firmware')):
    patterns = list(dict.fromkeys(line for line in map(str.strip, text.splitlines())
                    if re.fullmatch(r'[a-zA-Z0-9_./*?-]{1,160}', line)
                    and not line.startswith('/') and '..' not in Path(line).parts
                    and '**' not in line))
    return {'declared_candidates_not_all_required':True,
            'files':[{'pattern':pattern, 'present':any(
                any(p.is_file() for p in firmware_root.glob(pattern + suffix))
                for suffix in ('', '.xz', '.zst'))} for pattern in patterns[:256]],
            'truncated':len(patterns) > 256}


def wifi_scan_summary(text):
    signals = []
    for line in text.splitlines():
        if not line:
            continue
        signal, sep, _security = line.partition(':')
        if not sep or not signal.isdigit() or not 0 <= int(signal) <= 100:
            raise ValueError('unrecognized cached wireless data')
        signals.append(int(signal))
    return {'cache_only': True, 'network_count': len(signals),
            'strongest_signal_percent': max(signals) if signals else None}


def collect():
    result = {'schema_version': 1, 'at_utc': datetime.now(timezone.utc).isoformat(),
              'kernel': os.uname().release, 'physical_approval': 'PENDING',
              'hardware': hardware_ids(), 'device_state': device_state(), 'probes': {}}
    def save(name, argv, transform):
        p = probe(argv)
        value = {'status': p['status']}
        if p['status'] == 'ok':
            try:
                value['result'] = transform(p['data'])
            except (ValueError, TypeError, KeyError, AttributeError):
                value['status'] = 'unavailable'
        result['probes'][name] = value
    # Query separately: a missing optional package must not hide installed ones.
    result['packages'] = {}
    for package in PACKAGES:
        p = probe(['pacman', '-Q', package])
        parts = p['data'].split()
        result['packages'][package] = parts[1] if len(parts) == 2 and parts[0] == package and re.fullmatch(r'[a-zA-Z0-9:+_.-]+', parts[1]) else None
    units = ('NetworkManager.service', 'bluetooth.service', 'power-profiles-daemon.service')
    user_units = ('pipewire.service', 'pipewire-pulse.service', 'wireplumber.service', 'dms.service')
    for unit in (*units, *user_units):
        argv = ['systemctl', *(['--user'] if unit in user_units else []), 'show', unit,
                '--property=LoadState,ActiveState,SubState,Result,NRestarts,ExecMainCode,ExecMainStatus', '--no-pager']
        save(unit, argv, lambda text: dict(line.split('=', 1) for line in text.splitlines()
             if re.fullmatch(r'[A-Za-z]+=[A-Za-z0-9_-]*', line)))
    save('network_devices', ['nmcli', '-t', '-f', 'TYPE,STATE', 'device', 'status'],
         lambda text: [line for line in text.splitlines() if re.fullmatch(r'[a-z-]+:(?:connected|disconnected|unavailable|unmanaged|connecting|connecting \(getting IP configuration\)|connecting \(need authentication\)|connected \(externally\))', line)])
    save('wifi_radio', ['nmcli', 'radio', 'wifi'], lambda text: text.strip() if text.strip() in ('enabled', 'disabled') else 'unknown')
    save('cached_wifi_networks', ['nmcli', '-t', '-f', 'SIGNAL,SECURITY', 'device', 'wifi', 'list', '--rescan', 'no'], wifi_scan_summary)
    save('kernel_errors', ['journalctl', '-k', '-b', '-o', 'cat', '--no-pager', '-n', '3000'], kernel_summary)
    save('displays', ['hyprctl', '-j', 'monitors'], lambda text: display_summary(json.loads(text)))
    modules = sorted({row['module'] for kind in ('wireless', 'bluetooth')
                      for row in result['device_state'][kind] if row['module']})
    for module in modules:
        save('firmware:' + module, ['modinfo', '-F', 'firmware', module], firmware_summary)
    for kind in ('sink', 'source'):
        default = probe(['pactl', 'get-default-' + kind])['data'].strip()
        save('audio_' + kind + 's', ['pactl', '--format=json', 'list', kind + 's'],
             lambda text, default=default: audio_summary(json.loads(text), default))
    return result


def main():
    argparse.ArgumentParser(description=__doc__).parse_args()
    if os.geteuid() == 0:
        raise SystemExit('Run as the desktop user, not root: audio and DMS belong to its user session.')
    print(json.dumps(collect(), indent=2, sort_keys=True))


if __name__ == '__main__':
    main()
