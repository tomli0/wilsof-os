#!/usr/bin/env python3
"""M2 GUI acknowledgement. Never start, move or close an application.

M4 is absent: any dashboard surface is an unsupported state, not permission to
hide/kill it. Applied means saved profile plus verified absence of dashboard
surfaces in the current compositor, not a future dashboard hide/show contract.
"""
import argparse
import json
import os
from pathlib import Path
import runpy
import subprocess

state = runpy.run_path(str(Path(__file__).resolve().with_name('wilsof-profile')))


def verify_gui():
    if not os.environ.get('WAYLAND_DISPLAY') or not os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'):
        raise ValueError('No graphical Hyprland session; saved profile is not GUI-confirmed')
    for query in ('clients', 'layers'):
        result = subprocess.run(['hyprctl', '-j', query], capture_output=True, text=True,
                                check=True, timeout=3)
        if len(result.stdout) > 2 * 1024 * 1024:
            raise ValueError('Compositor response exceeds the supported limit')
        data = json.loads(result.stdout)
        if query == 'clients':
            if not isinstance(data, list) or any(not isinstance(c, dict) or 'class' not in c for c in data):
                raise ValueError('Invalid compositor client inventory')
            surfaces = data
        else:
            if not isinstance(data, dict):
                raise ValueError('Invalid compositor layer inventory')
            surfaces = []
            for monitor in data.values():
                if not isinstance(monitor, dict) or not isinstance(monitor.get('levels'), dict):
                    raise ValueError('Invalid compositor layer levels')
                for level in monitor['levels'].values():
                    if not isinstance(level, list) or any(not isinstance(c, dict) or 'namespace' not in c for c in level):
                        raise ValueError('Invalid compositor layer surfaces')
                    surfaces.extend(level)
        if any(c.get('class') == 'org.wilsof.Tasks'
               or c.get('initialClass') == 'org.wilsof.Tasks'
               or c.get('namespace') == 'org.wilsof.Tasks' for c in surfaces):
            raise ValueError('Dashboard surface detected; M4 hide/show acknowledgement is unavailable. '
                             'Profile not GUI-confirmed; no windows were changed')


def main():
    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
    commands = parser.add_subparsers(dest='command', required=True)
    commands.add_parser('status')
    apply = commands.add_parser('apply')
    apply.add_argument('profile', choices=state['PROFILES'])
    args = parser.parse_args()
    result = {'schema_version': 1, 'saved': None, 'applied': None, 'error': None}
    try:
        with state['state_directory'](Path.home(), create=args.command == 'apply') as directory:
            result['saved'] = state['read_profile'](directory)
            if args.command == 'apply':
                with state['writer_lock'](directory):
                    result['saved'] = state['read_profile'](directory)
                    verify_gui()
                    state['write_profile'](directory, args.profile)
                    result['saved'] = args.profile
                    verify_gui()
            else:
                verify_gui()
            if state['read_profile'](directory) != result['saved']:
                raise ValueError('Concurrent profile change; GUI confirmation pending')
            result['applied'] = result['saved']
    except (OSError, ValueError, RecursionError, subprocess.SubprocessError) as error:
        try:
            # A failure after rename can leave the new intent committed. Re-read
            # rather than reporting the pre-write profile as if it were preserved.
            with state['state_directory'](Path.home()) as directory:
                result['saved'] = state['read_profile'](directory)
            result['error'] = str(error)
        except (OSError, ValueError, RecursionError):
            result['saved'] = 'clean'
            result['error'] = f'{error}; CLEAN fallback; state preserved'
        print(json.dumps(result))
        return 1
    print(json.dumps(result))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
