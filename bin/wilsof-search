#!/bin/sh
# Open DMS Spotlight: apps by default, supported local provider categories on demand.
set -eu

if [ "${1:-}" != "toggle" ] || [ "$#" -ne 1 ]; then
  printf '%s\n' "Usage: wilsof-search toggle" >&2
  exit 64
fi

if ! command -v dms >/dev/null 2>&1; then
  printf '%s\n' "wilsof-search: DankMaterialShell (dms) is not available." >&2
  exit 69
fi

# DMS can return exit 0 even when an IPC target is absent. Require our marker;
# keep the working upstream launcher available when the plugin is disabled/broken.
reply=$(dms ipc call commandCenter toggle 2>/dev/null) || reply=''
case "$reply" in
  *WILSOF_COMMAND_CENTER_OK*|*WILSOF_COMMAND_CENTER_LOCKED*) exit 0 ;;
esac
# The plugin is disabled or broken: keep the upstream launcher available.
exec dms ipc call spotlight toggle
