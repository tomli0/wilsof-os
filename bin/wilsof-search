#!/bin/sh
# Both WS click and Super+Space address one resident Wilsof Menu.
set -eu
if [ "$#" -ne 1 ]; then
  printf '%s\n' 'Usage: wilsof-search toggle|configure' >&2
  exit 64
fi
case "$1" in
  toggle) reply=$(dms ipc call commandCenter toggle) ;;
  configure) reply=$(dms ipc call commandCenter configure) ;;
  *) printf '%s\n' 'Usage: wilsof-search toggle|configure' >&2; exit 64 ;;
esac
case "$reply" in
  *WILSOF_COMMAND_CENTER_OK*|*WILSOF_COMMAND_CENTER_LOCKED*) exit 0 ;;
  *) printf '%s\n' 'Wilsof Menu is unavailable. Check dms.service and the Wilsof Menu plugin.' >&2; exit 69 ;;
esac
