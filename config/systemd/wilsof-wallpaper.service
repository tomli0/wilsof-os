[Unit]
Description=Apply approved Wilsof OS wallpaper
PartOf=wilsof-session.target
Requires=dms.service
After=dms.service

[Service]
Type=oneshot
ExecCondition=/usr/bin/test -x /usr/bin/dms
ExecStart=/usr/bin/dms ipc call wallpaper set "%h/.local/share/wilsof-os/assets/Mørk geometrisk bakgrunn med isblått WS-monogram.png"

[Install]
WantedBy=wilsof-session.target
