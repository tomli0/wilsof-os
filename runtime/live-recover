#!/usr/bin/env python3
"""Narrow live-only diagnostics/retry; no arbitrary commands or target writes."""
from pathlib import Path
import os
import subprocess
import sys


def main(args):
    if args not in ([], ['--restart'], ['--show-failure']):
        raise SystemExit('Usage: wilsof-live-recover [--restart]')
    if os.geteuid() != 0 or not Path('/run/archiso/airootfs').is_mount():
        raise SystemExit('This helper is available only in the running live environment')
    if args == ['--show-failure']:
        subprocess.run(['plymouth', 'quit'], check=False, timeout=15)
        with open('/dev/tty2', 'w') as console:
            console.write('\nWilsof graphical startup failed. Recovery login is available here.\n')
            console.flush()
            subprocess.run(['journalctl', '-b', '-u', 'wilsof-live-setup', '-u', 'greetd',
                            '--no-pager', '-n', '35'], stdout=console, stderr=console,
                           check=False, timeout=20)
        subprocess.run(['chvt', '2'], check=False, timeout=10)
        return 0
    if args == ['--restart']:
        subprocess.run(['systemctl', 'reset-failed', 'wilsof-live-setup', 'greetd'], check=True, timeout=15)
        subprocess.run(['systemctl', 'restart', 'wilsof-live-setup'], check=True, timeout=180)
        subprocess.run(['systemctl', 'restart', 'greetd'], check=True, timeout=30)
    return subprocess.run(['journalctl', '-b', '-u', 'wilsof-live-setup', '-u', 'greetd',
                           '--no-pager', '-n', '100'], check=False, timeout=20).returncode


if __name__ == '__main__':
    raise SystemExit(main(sys.argv[1:]))
